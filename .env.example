PORT=8091

# Model name as listed in the LLM endpoint
LLM_MODEL=Qwen3-8B-Q4_K_M

# Preferred: call llama.cpp directly (the only LLM dependency of this app)
# LLM_URL=http://llama-backend:8080/v1

# Optional: route the LLM through Open WebUI on the shared "ai" network
# (only needed when LLM_URL is not set). Either an API key
# (Settings > Account > API Keys) ...
OPENWEBUI_URL=http://open-webui:8080
OPENWEBUI_API_KEY=
# ... or the login of an Open WebUI user
OPENWEBUI_EMAIL=
OPENWEBUI_PASSWORD=

# How many catalog documents the local keyword search hands to the plugin matcher.
# The knowledge base itself is a BM25 index built from the catalog/ folder, no external service.
KB_TOP_K=6
