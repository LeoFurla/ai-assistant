PORT=8091

# Open WebUI on the shared "ai" network
OPENWEBUI_URL=http://open-webui:8080

# Either an API key (Settings > Account > API Keys) ...
OPENWEBUI_API_KEY=
# ... or the login of an Open WebUI user
OPENWEBUI_EMAIL=
OPENWEBUI_PASSWORD=

# Model as listed in Open WebUI
LLM_MODEL=Qwen3-8B-Q4_K_M

# Optional: call llama.cpp directly instead of through Open WebUI
# LLM_URL=http://llama-backend:8080/v1

# Knowledge base; KB_ID pins it so the empty duplicate is never picked.
# Leave KB_ID empty to auto-create/look up by KB_NAME (then pin the real UUID in .env).
KB_NAME=AI Assistant
KB_ID=
KB_TOP_K=6
